{
    "name": "signal",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "pnpm --filter @capyplan/protocol build && pnpm --filter @capyplan/db build && tsc",
        "start": "pnpm --filter @capyplan/db push && node dist/scripts/seed.js && node dist/index.js",
        "test": "vitest",
        "seed": "tsx src/scripts/seed.ts",
        "db:reset": "tsx src/scripts/reset.ts && pnpm --filter @capyplan/db push && pnpm seed"
    },
    "dependencies": {
        "@capyplan/db": "workspace:*",
        "@capyplan/protocol": "workspace:*",
        "@fastify/cors": "^9.0.1",
        "@fastify/websocket": "^8.3.1",
        "dotenv": "^16.4.1",
        "drizzle-orm": "^0.29.3",
        "fastify": "^4.26.1",
        "ws": "^8.16.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/ws": "^8.5.10",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}